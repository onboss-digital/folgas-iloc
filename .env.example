# ==============================================================================
# VARIÁVEIS DE AMBIENTE - FOLGAS ILOC
# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase.
# ==============================================================================

# URL do seu projeto Supabase (encontrada em: Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública (encontrada em: Project Settings -> API -> Project API Keys -> anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-supabase-aqui
